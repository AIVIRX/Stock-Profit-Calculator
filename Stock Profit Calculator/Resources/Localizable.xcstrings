    "Test your knowledge and climb the leaderboard! Choose a chapter to begin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختبر معلوماتك وتصدر قائمة المتصدرين! اختر فصلًا للبدء."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверете знанията си и се изкачете в класацията! Изберете глава, за да започнете."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তোমার জ্ঞান পরীক্ষা করো এবং লিডারবোর্ডে আরোহণ করো! শুরু করার জন্য একটি অধ্যায় বেছে নাও।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posa a prova els teus coneixements i puja a la classificació! Tria un capítol per començar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otestujte si své znalosti a vyšplhejte se v žebříčku! Vyberte si kapitolu a začněte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test din viden og klatr op på ranglisten! Vælg et kapitel for at begynde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testen Sie Ihr Wissen und erklimmen Sie die Bestenliste! Wählen Sie ein Kapitel, um zu beginnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάστε τις γνώσεις σας και ανεβείτε στον πίνακα κατάταξης! Επιλέξτε ένα κεφάλαιο για να ξεκινήσετε."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test your knowledge and climb the leaderboard! Choose a chapter to begin."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test your knowledge and climb the leaderboard! Choose a chapter to begin."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test your knowledge and climb the leaderboard! Choose a chapter to begin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Pon a prueba tus conocimientos y escala posiciones! Elige un capítulo para empezar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon a prueba tus conocimientos y sube en la clasificación. Elige un capítulo para empezar."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Pon a prueba tus conocimientos y escala posiciones! Elige un capítulo para empezar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testaa tietosi ja kiipeä tulostaulukossa! Valitse luku aloittaaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testez vos connaissances et grimpez au classement ! Choisissez un chapitre pour commencer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testez vos connaissances et montez au classement ! Choisissez un chapitre pour commencer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા જ્ઞાનની કસોટી કરો અને લીડરબોર્ડ પર ચઢો! શરૂ કરવા માટે એક પ્રકરણ પસંદ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחנו את הידע שלכם וטפסו על טבלת הדירוג! בחרו פרק כדי להתחיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने ज्ञान का परीक्षण करें और लीडरबोर्ड पर चढ़ें! शुरू करने के लिए एक अध्याय चुनें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testirajte svoje znanje i popnite se na ljestvicu! Odaberite poglavlje za početak."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teszteld a tudásod és mássz fel a ranglistára! Válassz egy fejezetet a kezdéshez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uji pengetahuan Anda dan naiki papan peringkat! Pilih bab untuk memulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti alla prova le tue conoscenze e scala la classifica! Scegli un capitolo per iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの知識を試して、リーダーボードを駆け上がりましょう！ 章を選択して始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지식을 시험하고 순위표에 이름을 올려보세요! 시작할 챕터를 선택하세요."
