    "Add your stock purchases below. Enter a selling price and commission fee to see your total potential profit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مشترياتك من الأسهم أدناه. أدخل سعر البيع ورسوم العمولة لمعرفة إجمالي ربحك المحتمل."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете покупките си на акции по-долу. Въведете продажна цена и комисионна, за да видите общата си потенциална печалба."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিচে আপনার স্টক ক্রয় যোগ করুন। আপনার মোট সম্ভাব্য লাভ দেখতে একটি বিক্রয় মূল্য এবং কমিশন ফি লিখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afegeix les teves compres d'accions a continuació. Introdueix un preu de venda i una comissió per veure el teu benefici potencial total."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte níže své nákupy akcií. Zadejte prodejní cenu a provizi a zobrazte si svůj celkový potenciální zisk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj dine aktiekøb nedenfor. Indtast en salgspris og et provisionsgebyr for at se din samlede potentielle fortjeneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie unten Ihre Aktienkäufe hinzu. Geben Sie einen Verkaufspreis und eine Provision ein, um Ihren potenziellen Gesamtgewinn zu sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε τις αγορές μετοχών σας παρακάτω. Εισαγάγετε μια τιμή πώλησης και μια προμήθεια για να δείτε το συνολικό πιθανό κέρδος σας."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your stock purchases below. Enter a selling price and commission fee to see your total potential profit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your stock purchases below. Enter a selling price and commission fee to see your total potential profit."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your stock purchases below. Enter a selling price and commission fee to see your total potential profit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue sus compras de acciones a continuación. Ingrese el precio de venta y la comisión para ver su ganancia potencial total."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue sus compras de acciones a continuación. Ingrese el precio de venta y la comisión para ver su ganancia potencial total."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue sus compras de acciones a continuación. Ingrese el precio de venta y la comisión para ver su ganancia potencial total."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää osakeostoksesi alle. Syötä myyntihinta ja palkkio nähdäksesi potentiaalisen kokonaisvoittosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez vos achats d'actions ci-dessous. Saisissez un prix de vente et une commission pour connaître votre bénéfice potentiel total."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez vos achats d'actions ci-dessous. Entrez un prix de vente et des frais de commission pour voir votre bénéfice potentiel total."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નીચે તમારી સ્ટોક ખરીદીઓ ઉમેરો. તમારો કુલ સંભવિત નફો જોવા માટે વેચાણ કિંમત અને કમિશન ફી દાખલ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף את רכישות המניות שלך למטה. הזן מחיר מכירה ועמלה כדי לראות את הרווח הפוטנציאלי הכולל שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे अपनी स्टॉक खरीदारी जोड़ें। अपना कुल संभावित लाभ देखने के लिए बिक्री मूल्य और कमीशन शुल्क दर्ज करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte kupnje dionica u nastavku. Unesite prodajnu cijenu i proviziju kako biste vidjeli svoju ukupnu potencijalnu dobit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add hozzá a részvényvásárlásaidat alább. Add meg az eladási árat és a jutalékot a teljes potenciális profitod megtekintéséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan pembelian saham Anda di bawah ini. Masukkan harga jual dan biaya komisi untuk melihat total potensi keuntungan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi i tuoi acquisti azionari qui sotto. Inserisci un prezzo di vendita e una commissione per visualizzare il tuo potenziale profitto totale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下記に株式購入を追加してください。売却価格と手数料を入力すると、潜在的な利益総額が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에 주식 매수 금액을 입력하세요. 판매 가격과 수수료를 입력하면 총 예상 수익을 확인할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah pembelian stok anda di bawah. Masukkan harga jualan dan yuran komisen untuk melihat jumlah potensi keuntungan anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg hieronder uw aandelenaankopen toe. Voer een verkoopprijs en commissie in om uw totale potentiële winst te bekijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj swoje zakupy akcji poniżej. Wprowadź cenę sprzedaży i prowizję, aby zobaczyć swój całkowity potencjalny zysk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione suas compras de ações abaixo. Insira um preço de venda e uma taxa de comissão para ver seu lucro potencial total."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione as suas compras de ações abaixo. Introduza um preço de venda e uma taxa de comissão para ver o seu lucro potencial total."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați achizițiile de acțiuni mai jos. Introduceți un preț de vânzare și un comision pentru a vedea profitul total potențial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте ниже ваши покупки акций. Введите цену продажи и комиссию, чтобы увидеть вашу общую потенциальную прибыль."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridajte nižšie svoje nákupy akcií. Zadajte predajnú cenu a províziu a pozrite si svoj celkový potenciálny zisk."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spodaj dodajte nakupe delnic. Vnesite prodajno ceno in provizijo, da si ogledate svoj skupni potencialni dobiček."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till dina aktieköp nedan. Ange ett försäljningspris och en provisionsavgift för att se din totala potentiella vinst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มรายการซื้อหุ้นของคุณด้านล่าง ป้อนราคาขายและค่าคอมมิชชันเพื่อดูกำไรรวมที่อาจได้รับ"
