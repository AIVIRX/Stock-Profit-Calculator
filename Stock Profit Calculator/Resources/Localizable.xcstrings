          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Testen Sie Ihr Wissen und erklimmen Sie die Bestenliste! Wählen Sie ein Kapitel, um zu beginnen.",
            "state" : "translated"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išbandyk savo žinias ir lipk į lyderių lentelę! Pasirink skyrių, kad pradėtum."
          }
        },
        "id-ID" : {
          "stringUnit" : {
            "value" : "Uji pengetahuanmu dan naikkan peringkat! Pilih bab untuk memulai.",
