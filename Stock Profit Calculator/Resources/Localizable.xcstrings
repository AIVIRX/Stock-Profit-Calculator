          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "測試您的知識並攀登排行榜！選擇一個章節開始。",
            "state" : "translated"
          }
        },
        "he" : {
          "stringUnit" : {
            "value" : "בחנו את הידע שלכם וטפסו על טבלת הדירוג! בחרו פרק כדי להתחיל.",
            "state" : "translated"
          }
        },
        "ms" : {
          "stringUnit" : {
            "value" : "Uji pengetahuan anda dan naik papan pendahulu! Pilih bab untuk bermula.",
