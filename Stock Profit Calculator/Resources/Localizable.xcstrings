        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti alla prova le tue conoscenze e scala la classifica! Scegli un capitolo per iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの知識を試して、リーダーボードを駆け上がりましょう！ 章を選択して始めましょう。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Біліміңізді сынап, көшбасшылар тақтасында жоғарылаңыз! Бастау үшін тарауды таңдаңыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಜ್ಞಾನವನ್ನು ಪರೀಕ್ಷಿಸಿ ಮತ್ತು ಲೀಡರ್ಬೋರ್ಡ್‌ನಲ್ಲಿ ಏರಿಕೆ ಮಾಡಿ! ಪ್ರಾರಂಭಿಸಲು ಅಧ್ಯಾಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지식을 시험하고 순위표에 이름을 올려보세요! 시작할 챕터를 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išbandyk savo žinias ir lipk į lyderių lentelę! Pasirink skyrių, kad pradėtum."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ അറിവ് പരീക്ഷിച്ച് ലീഡർബോർഡിൽ ഉയരുക! ആരംഭിക്കാൻ ഒരു അദ്ധ്യായം തിരഞ്ഞെടുക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे ज्ञान तपासा आणि लीडरबोर्डवर चढा! सुरू करण्यासाठी एक अध्याय निवडा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uji pengetahuan anda dan naik papan pendahulu! Pilih bab untuk bermula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test kunnskapen din og klatre på topplisten! Velg et kapittel for å begynne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test je kennis en beklim de ranglijst! Kies een hoofdstuk om te beginnen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କର ଜ୍ଞାନ ପରୀକ୍ଷା କରନ୍ତୁ ଏବଂ ଲିଡରବୋର୍ଡ୍ ଉପରେ ଚଢ଼ନ୍ତୁ! ଆରମ୍ଭ କରିବା ପାଇଁ ଏକ ଅଧ୍ୟାୟ ଚୟନ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੀ ਜਾਣਕਾਰੀ ਦੀ ਜਾਂਚ ਕਰੋ ਅਤੇ ਲੀਡਰਬੋਰਡ 'ਤੇ ਚੜ੍ਹੋ! ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਇੱਕ ਅਧਿਆਇ ਚੁਣੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź swoją wiedzę i pnij się w górę tabeli liderów! Wybierz rozdział, aby rozpocząć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
