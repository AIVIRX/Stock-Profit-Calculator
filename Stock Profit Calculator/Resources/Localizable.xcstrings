          }
        },
        "ml" : {
          "stringUnit" : {
            "value" : "നിങ്ങളുടെ അറിവ് പരീക്ഷിച്ച് ലീഡർബോർഡിൽ ഉയരുക! ആരംഭിക്കാൻ ഒരു അദ്ധ്യായം തിരഞ്ഞെടുക്കുക.",
            "state" : "translated"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "value" : "測試您的知識並攀登排行榜！選擇一個章節開始。",
            "state" : "translated"
          }
        },
        "bn" : {
          "stringUnit" : {
            "value" : "তোমার জ্ঞান পরীক্ষা করো এবং লিডারবোর্ডে আরোহণ করো! শুরু করার জন্য একটি অধ্যায় বেছে নাও।",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "¡Pon a prueba tus conocimientos y escala posiciones! Elige un capítulo para empezar.",
