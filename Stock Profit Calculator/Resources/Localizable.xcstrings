    "Test your knowledge and climb the leaderboard! Choose a chapter to begin." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "value" : "Pon a prueba tus conocimientos y sube en la clasificación. Elige un capítulo para empezar.",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "ทดสอบความรู้ของคุณและไต่อันดับขึ้นไปบนกระดานผู้นำ! เลือกบทที่จะเริ่มต้น",
            "state" : "translated"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "value" : "Testez vos connaissances et montez au classement ! Choisissez un chapitre pour commencer.",
            "state" : "translated"
          }
        },
        "kn" : {
          "stringUnit" : {
            "value" : "ನಿಮ್ಮ ಜ್ಞಾನವನ್ನು ಪರೀಕ್ಷಿಸಿ ಮತ್ತು ಲೀಡರ್ಬೋರ್ಡ್‌ನಲ್ಲಿ ಏರಿಕೆ ಮಾಡಿ! ಪ್ರಾರಂಭಿಸಲು ಅಧ್ಯಾಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ.",
            "state" : "translated"
          }
        },
        "hr" : {
          "stringUnit" : {
            "value" : "Testirajte svoje znanje i popnite se na ljestvicu! Odaberite poglavlje za početak.",
            "state" : "translated"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź swoją wiedzę i wspinaj się na szczyt tabeli wyników! Wybierz rozdział, aby rozpocząć."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "あなたの知識を試して、リーダーボードを駆け上がりましょう！ 章を選択して始めましょう。",
            "state" : "translated"
          }
        },
        "or" : {
          "stringUnit" : {
            "value" : "ଆପଣଙ୍କର ଜ୍ଞାନ ପରୀକ୍ଷା କରନ୍ତୁ ଏବଂ ଲିଡରବୋର୍ଡ୍ ଉପରେ ଚଢ଼ନ୍ତୁ! ଆରମ୍ଭ କରିବା ପାଇଁ ଏକ ଅଧ୍ୟାୟ ଚୟନ କରନ୍ତୁ।",
            "state" : "translated"
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "value" : "Test your knowledge and climb the leaderboard! Choose a chapter to begin.",
            "state" : "translated"
          }
        },
        "gu" : {
          "stringUnit" : {
            "value" : "તમારા જ્ઞાનની કસોટી કરો અને લીડરબોર્ડ પર ચઢો! શરૂ કરવા માટે એક પ્રકરણ પસંદ કરો.",
            "state" : "translated"
          }
        },
        "bg" : {
          "stringUnit" : {
            "value" : "Тествайте знанията си и се изкачете в класацията! Изберете глава, за да започнете.",
            "state" : "translated"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ జ్ఞానాన్ని పరీక్షించి లీడర్బోర్డులో ఎక్కండి! ప్రారంభించడానికి ఒక అధ్యాయం ఎంచుకోండి."
          }
        },
        "nb" : {
          "stringUnit" : {
            "value" : "Test kunnskapen din og klatre på topplisten! Velg et kapittel for å begynne.",
            "state" : "translated"
          }
        },
        "pa" : {
          "stringUnit" : {
            "value" : "ਆਪਣੀ ਜਾਣਕਾਰੀ ਦੀ ਜਾਂਚ ਕਰੋ ਅਤੇ ਲੀਡਰਬੋਰਡ 'ਤੇ ਚੜ੍ਹੋ! ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਇੱਕ ਅਧਿਆਇ ਚੁਣੋ।",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Testa dina kunskaper och klättra på topplistan! Välj ett kapitel för att börja.",
            "state" : "translated"
          }
        },
        "kk" : {
          "stringUnit" : {
            "value" : "Біліміңізді сынап, көшбасшылар тақтасында жоғарылаңыз! Бастау үшін тарауды таңдаңыз.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Pon a prueba tus conocimientos y escala posiciones! Elige un capítulo para empezar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지식을 시험하고 순위표에 이름을 올려보세요! 시작할 챕터를 선택하세요."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Teste os seus conhecimentos e suba na classificação! Escolha um capítulo para começar.",
            "state" : "translated"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "value" : "Test your knowledge and climb the leaderboard! Choose a chapter to begin.",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilginizi test edin ve liderlik tablosunda yükselin! Başlamak için bir bölüm seçin."
          }
        },
        "sk" : {
          "stringUnit" : {
            "value" : "Otestujte si svoje vedomosti a vyšplhajte sa v rebríčku! Vyberte si kapitolu a začnite.",
            "state" : "translated"
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Preizkusite svoje znanje in se povzpnite na lestvico najboljših! Izberite poglavje za začetek.",
            "state" : "translated"
