    "Test your knowledge and climb the leaderboard! Choose a chapter to begin." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "value" : "Δοκιμάστε τις γνώσεις σας και ανεβείτε στον πίνακα κατάταξης! Επιλέξτε ένα κεφάλαιο για να ξεκινήσετε.",
            "state" : "translated"
          }
        },
        "fi" : {
          "stringUnit" : {
            "value" : "Testaa tietosi ja kiipeä tulostaulukossa! Valitse luku aloittaaksesi.",
            "state" : "translated"
          }
        },
        "ar" : {
          "stringUnit" : {
            "value" : "اختبر معرفتك وتسلق لوحة المتصدرين! اختر فصلًا للبدء.",
            "state" : "translated"
          }
        },
        "or" : {
          "stringUnit" : {
            "value" : "ଆପଣଙ୍କର ଜ୍ଞାନ ପରୀକ୍ଷା କରନ୍ତୁ ଏବଂ ଲିଡରବୋର୍ଡ୍ ଉପରେ ଚଢ଼ନ୍ତୁ! ଆରମ୍ଭ କରିବା ପାଇଁ ଏକ ଅଧ୍ୟାୟ ଚୟନ କରନ୍ତୁ।",
            "state" : "translated"
          }
        },
        "mr" : {
          "stringUnit" : {
            "value" : "तुमचे ज्ञान तपासा आणि लीडरबोर्डवर चढा! सुरू करण्यासाठी एक अध्याय निवडा.",
            "state" : "translated"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ జ్ఞానాన్ని పరీక్షించి లీడర్బోర్డులో ఎక్కండి! ప్రారంభించడానికి ఒక అధ్యాయం ఎంచుకోండి."
          }
        },
        "lt" : {
          "stringUnit" : {
            "value" : "Išbandyk savo žinias ir lipk į lyderių lentelę! Pasirink skyrių, kad pradėtum.",
            "state" : "translated"
          }
        },
        "ro" : {
          "stringUnit" : {
            "value" : "Testează-ți cunoștințele și urcă în clasament! Alege un capitol pentru a începe.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Test your knowledge and climb the leaderboard! Choose a chapter to begin.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra kiến thức của bạn và leo lên bảng xếp hạng! Chọn một chương để bắt đầu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "value" : "Preizkusite svoje znanje in se povzpnite na lestvico najboljših! Izberite poglavje za začetek.",
